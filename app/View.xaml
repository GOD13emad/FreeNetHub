<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="FreeNet Hub" Width="1180" Height="840" MinWidth="850" MinHeight="600" WindowStartupLocation="CenterScreen" Background="{DynamicResource Bg}" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI, Tahoma" FontSize="14" UseLayoutRounding="True">
<Window.Resources>
<SolidColorBrush x:Key="Bg" Color="#0B1423"/><SolidColorBrush x:Key="Panel" Color="#132135"/><SolidColorBrush x:Key="Ink" Color="#ECF2FA"/><SolidColorBrush x:Key="Muted" Color="#A4B8CF"/><SolidColorBrush x:Key="Line" Color="#2D435C"/><SolidColorBrush x:Key="Accent" Color="#39CDB4"/><SolidColorBrush x:Key="Soft" Color="#1C3046"/>
<Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Style>
<Style TargetType="Button"><Setter Property="Background" Value="{DynamicResource Soft}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="Padding" Value="16,11"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="Cursor" Value="Hand"/><Setter Property="MinHeight" Value="42"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#54CCBA"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderThickness" Value="2"/><Setter TargetName="B" Property="BorderBrush" Value="#DEA857"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.45"/><Setter Property="Cursor" Value="Arrow"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="TextBox"><Setter Property="Background" Value="{DynamicResource Bg}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="Padding" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
<Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Margin" Value="0,9"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
<Style TargetType="TabItem"><Setter Property="Padding" Value="17,10"/><Setter Property="Foreground" Value="#16334A"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
<Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{DynamicResource Panel}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="20"/></Style>
</Window.Resources>
<Grid Margin="22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="228"/></Grid.ColumnDefinitions>
<Border Grid.Column="1" Style="{StaticResource Card}" Margin="18,0,0,0"><DockPanel>
<StackPanel DockPanel.Dock="Top"><TextBlock Text="FREENET" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource Accent}"/><TextBlock Text="HUB / 4.0" FontSize="13" FontWeight="SemiBold" Margin="1,1,0,22" Foreground="{DynamicResource Muted}"/>
<Border Background="{DynamicResource Soft}" CornerRadius="10" Padding="13"><StackPanel FlowDirection="RightToLeft"><TextBlock Name="SidebarState" Text="آمادهٔ انتخاب" FontSize="18" FontWeight="SemiBold"/><TextBlock Name="SidebarDetail" Text="باز شدن برنامه، VPN را روشن نمی‌کند." Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,8,0,0"/></StackPanel></Border>
<Button Name="QuickConnect" Content="اتصال هوشمند" Background="#147F70" Foreground="White" Margin="0,16,0,9" FontWeight="Bold"/>
<Button Name="QuickStop" Content="قطع اتصال‌های همین برنامه" Margin="0,0,0,9"/>
<Separator Margin="0,13"/><TextBlock Text="محدودهٔ فعال" FontWeight="SemiBold" FlowDirection="RightToLeft"/><TextBlock Text="فقط مرورگر اختصاصی؛ Firefox، DNS ویندوز و مسیر پیش‌فرض تغییر نمی‌کنند." FlowDirection="RightToLeft" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,8,0,18"/>
<Button Name="Help" Content="راهنمای آفلاین" Margin="0,0,0,9"/><Button Name="Theme" Content="تغییر روشن / تیره" Margin="0,0,0,9"/>
</StackPanel><TextBlock VerticalAlignment="Bottom" Text="یک مرکز کنترل&#10;بدون ترمینال اضافی&#10;بدون تبلیغات" Foreground="{DynamicResource Muted}" FlowDirection="RightToLeft" FontSize="12"/></DockPanel></Border>
<Grid Grid.Column="0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid Margin="2,0,2,18" FlowDirection="RightToLeft"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="اتصال، با کنترل و شفافیت" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="مسیر مناسب را پیدا کن؛ نتیجهٔ واقعی را ببین." Foreground="{DynamicResource Muted}" Margin="0,5,0,0"/></StackPanel><Border Grid.Column="1" Background="{DynamicResource Soft}" CornerRadius="8" Padding="12,8" VerticalAlignment="Center"><TextBlock Text="BROWSER EDITION" FontSize="10" FontWeight="SemiBold" FlowDirection="LeftToRight"/></Border></Grid>
<TabControl Name="Tabs" Grid.Row="1" Background="Transparent" BorderThickness="0" FlowDirection="RightToLeft">
<TabItem Header="اتصال"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,16,0,0">
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Name="StatusTitle" Text="هنوز مسیری در این جلسه آزمایش نشده" FontSize="24" FontWeight="SemiBold"/><TextBlock Name="StatusDetail" Text="حالت خودکار فقط مسیرهای تونلی را انتخاب می‌کند؛ نه اتصال مستقیم پنهانی." Foreground="{DynamicResource Muted}" Margin="0,10,0,20"/>
<UniformGrid Columns="3"><StackPanel><TextBlock Text="مسیر" Foreground="{DynamicResource Muted}" FontSize="12"/><TextBlock Name="RouteValue" Text="—" FontSize="18" Margin="0,8"/></StackPanel><StackPanel><TextBlock Text="کشور گزارش‌شده" Foreground="{DynamicResource Muted}" FontSize="12"/><TextBlock Name="CountryValue" Text="نامشخص" FontSize="18" Margin="0,8"/></StackPanel><StackPanel><TextBlock Text="زمان پاسخ HTTPS" Foreground="{DynamicResource Muted}" FontSize="12"/><TextBlock Name="LatencyValue" Text="—" FontSize="18" Margin="0,8"/></StackPanel></UniformGrid>
<Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Name="IpValue" Text="IP نمایش داده نشده" FontFamily="Consolas" FlowDirection="LeftToRight" HorizontalAlignment="Right" Foreground="{DynamicResource Muted}"/><CheckBox Grid.Column="1" Name="ShowIp" Content="نمایش IP" Margin="8,0"/></Grid><ProgressBar Name="Progress" Height="5" Margin="0,18,0,8" Foreground="#39B99F" Background="{DynamicResource Soft}"/><TextBlock Name="Elapsed" Text="بدون عملیات فعال" FontSize="11" Foreground="{DynamicResource Muted}"/></StackPanel></Border>
<Border Style="{StaticResource Card}" Margin="0,14,0,0"><StackPanel><TextBlock Text="حالت اتصال" FontSize="17" FontWeight="SemiBold"/><Grid Margin="0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox Name="Mode" Height="42" SelectedIndex="0" Margin="0,0,8,0" VerticalContentAlignment="Center" Foreground="#163047"><ComboBoxItem Tag="AUTO" Content="خودکار · فقط تونل رایگان"/><ComboBoxItem Tag="WARP" Content="WARP · سریع / کشور ممکن است IR بماند"/><ComboBoxItem Tag="GOOL" Content="GOOL · WARP در WARP"/><ComboBoxItem Tag="CFON" Content="CFON · WARP + Psiphon / کشور انتخابی"/><ComboBoxItem Tag="TOR" Content="Tor / Snowflake · مسیر مستقل پشتیبان"/><ComboBoxItem Tag="WEBTUNNEL" Content="Tor / WebTunnel · نیازمند پل خصوصی"/><ComboBoxItem Tag="OBFS4" Content="Tor / obfs4 · نیازمند پل خصوصی"/><ComboBoxItem Tag="CUSTOM" Content="پروکسی محلی شخصی · خارج از AUTO"/><ComboBoxItem Tag="DIRECT" Content="مستقیم · بدون VPN / فقط انتخاب صریح"/></ComboBox><Button Grid.Column="1" Name="Connect" Content="شروع اتصال" Background="#147F70" Foreground="White" FontWeight="Bold" Margin="0" Padding="26,10"/></Grid>
<WrapPanel><Button Name="Browser" Content="باز کردن مرورگر"/><Button Name="Verify" Content="بررسی مسیر انتخاب‌شده"/><Button Name="Cancel" Content="لغو تلاش" IsEnabled="False"/></WrapPanel><TextBlock Text="پاسخ HTTPS موفق، ورود حساب یا اجرای بازی را تضمین نمی‌کند. کشور AT با پاسخ واقعی بررسی می‌شود؛ T1 کد ویژهٔ Tor است." FontSize="12" Foreground="{DynamicResource Muted}"/></StackPanel></Border>
<Border Style="{StaticResource Card}" Margin="0,14,0,0"><StackPanel><TextBlock Text="پایایی اختیاری" FontWeight="SemiBold"/><WrapPanel><CheckBox Name="Monitor" Content="بررسی هر ۴۵ ثانیه در همین پنل" Margin="8,10"/><CheckBox Name="AutoRepair" Content="بازیابی محدود پس از ۳ شکست" Margin="8,10"/></WrapPanel><TextBlock Text="پیش‌فرض خاموش. بازیابی حداکثر دو بار تلاش می‌کند؛ هیچ reset یا تغییر DNS انجام نمی‌دهد." FontSize="12" Foreground="{DynamicResource Muted}"/></StackPanel></Border>
</StackPanel></ScrollViewer></TabItem>
<TabItem Header="تاب‌آوری"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,16">
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="مسیر جایگزین، نه وعدهٔ اتصال همیشگی" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="WARP، GOOL و CFON زیرساخت مشترک دارند؛ Tor و پل‌ها خانوادهٔ متفاوتی هستند. در نبود همهٔ مسیرهای خارجی، اتصال تضمین‌شده نیست." Margin="0,10,0,16" Foreground="{DynamicResource Muted}"/><Button Name="Scan" Content="آزمایش و رتبه‌بندی چهار مسیر" HorizontalAlignment="Right"/><TextBlock Name="ScanSummary" Text="اسکن به‌صورت ترتیبی اجرا می‌شود تا رقابت چند موتور و پنجرهٔ اضافی ایجاد نشود." Foreground="{DynamicResource Muted}" FontSize="12"/></StackPanel></Border>
<Border Style="{StaticResource Card}" Margin="0,14,0,0"><StackPanel><TextBlock Text="پل خصوصی Tor" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="خط کامل پل را از منبع رسمی Tor تهیه کن. ذخیرهٔ معتبر با موفقیت اتصال فرق دارد؛ هیچ پل ساختگی وارد نمی‌شود." Margin="0,8,0,14" Foreground="{DynamicResource Muted}"/><WrapPanel><Button Name="ImportWeb" Content="وارد کردن فایل WebTunnel"/><Button Name="ImportObfs" Content="وارد کردن فایل obfs4"/><Button Name="BridgeHelp" Content="روش دریافت پل"/></WrapPanel><TextBlock Name="BridgeStatus" Text="پل‌ها: بررسی موجودی لازم است" Foreground="{DynamicResource Muted}"/></StackPanel></Border>
<Border Style="{StaticResource Card}" Margin="0,14,0,0"><StackPanel><TextBlock Text="VPN کل سیستم و روش‌های مدیریتی" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="TUN، Kill Switch، FAST/WinDivert و Hybrid به دسترسی مدیریتی و پذیرش جداگانه نیاز دارند. این انتشار برای جلوگیری از تکرار قطع اینترنت آن‌ها را خودکار اجرا نمی‌کند." Margin="0,10,0,10" Foreground="{DynamicResource Muted}"/><Button Content="Full System — گیت امنیتی باز" IsEnabled="False" HorizontalAlignment="Right"/><Button Name="AdvancedHelp" Content="مسیر آزمون و امکانات پیشرفته" HorizontalAlignment="Right"/></StackPanel></Border>
</StackPanel></ScrollViewer></TabItem>
<TabItem Header="ابزارها"><Grid Margin="0,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><WrapPanel><Button Name="Inventory" Content="موجودی بدون اتصال"/><Button Name="Doctor" Content="عیب‌یابی اینترنت مستقیم"/><Button Name="Speed" Content="سرعت نمونهٔ ۲MB"/><Button Name="Updates" Content="بررسی نسخه‌ها؛ بدون نصب"/><Button Name="Export" Content="گزارش پالایش‌شده"/></WrapPanel><TextBlock Grid.Row="1" Text="نتیجهٔ هر کار با شناسه و زمان ثبت می‌شود. تست مستقیم ممکن است آدرس IP اصلی را به مقصد همان آزمون نشان دهد." Foreground="{DynamicResource Muted}" Margin="0,3,0,12" FontSize="12"/><TextBox Grid.Row="2" Name="Details" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" FlowDirection="LeftToRight" Text="No operation has started. Opening the app does not connect."/><WrapPanel Grid.Row="3" Margin="0,10,0,0"><Button Name="Copy" Content="کپی نتیجهٔ نمایش‌داده‌شده"/><Button Name="Logs" Content="پوشهٔ شواهد"/></WrapPanel></Grid></TabItem>
<TabItem Header="پژوهش"><Grid Margin="0,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="مقایسهٔ محصولات و خانوادهٔ روش‌ها" FontSize="23" FontWeight="SemiBold"/><TextBox Name="Search" Grid.Row="1" Margin="0,14" ToolTip="جست‌وجو در محصولات، نیاز به سرور و کاربرد"/><TextBox Name="ResearchText" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" FontSize="13"/><TextBlock Grid.Row="3" Text="منابع: صفحات اصلی پروژه‌ها و فروشگاه رسمی؛ ادعای ارائه‌دهنده با تأیید روی این رایانه یکی نیست. فهرست، جامعِ نماینده است نه تمام محصولات دنیا." Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,10"/></Grid></TabItem>
<TabItem Header="تنظیمات"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,16"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="تنظیمات شفاف؛ بدون تغییر پنهانی سیستم" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="کشور CFON" Margin="0,20,0,6"/><ComboBox Name="Country" Width="200" Height="36" HorizontalAlignment="Right" SelectedIndex="0"><ComboBoxItem Content="AT"/><ComboBoxItem Content="DE"/><ComboBoxItem Content="NL"/><ComboBoxItem Content="US"/><ComboBoxItem Content="CA"/><ComboBoxItem Content="GB"/><ComboBoxItem Content="FR"/><ComboBoxItem Content="SG"/><ComboBoxItem Content="JP"/></ComboBox><TextBlock Text="نشانی شروع مرورگر — HTTPS" Margin="0,15,0,6"/><TextBox Name="Home" FlowDirection="LeftToRight"/><TextBlock Text="پروکسی محلی شخصی — SOCKS5h یا HTTP روی loopback" Margin="0,15,0,6"/><TextBox Name="CustomProxy" FlowDirection="LeftToRight"/><TextBlock Text="نمونه: socks5h://127.0.0.1:9909 — بدون نام کاربری/رمز؛ هرگز وارد AUTO نمی‌شود." FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,6,0,0"/><CheckBox Name="TrayOption" Content="با کوچک‌کردن پنجره، برنامه به سینی ویندوز برود"/><Button Name="Save" Content="ذخیرهٔ تنظیمات" HorizontalAlignment="Right" Margin="0,12"/><TextBlock Text="Startup خاموش است و در این نسخه نصب نمی‌شود. کلید WARP، کوکی مرورگر و پل خصوصی در گزارش عمومی قرار نمی‌گیرند." Foreground="{DynamicResource Muted}"/></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
</TabControl><TextBlock Grid.Row="2" Name="Footer" Text="FreeNet Hub 4.1.1 · Standalone desktop shell · No network change on launch" FontSize="10" Foreground="{DynamicResource Muted}" Margin="3,14,0,0"/></Grid></Grid></Window>
